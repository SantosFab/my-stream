# TMDB API Bearer token (from https://www.themoviedb.org/settings/api)
TMDB_API_TOKEN=your_tmdb_api_read_access_token_here

# Single-password site gate (SHA-256 hex of the access password).
# Generate with: node -e "console.log(require('node:crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
SITE_ACCESS_PASSWORD_HASH=your_sha256_hex_here

# Secret used to sign the site-auth cookie (any long random string).
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SITE_AUTH_SECRET=your_random_secret_here
